// Free Certifications Directory Handler

let certificationsData = [];

async function loadCertifications() {
  const container = document.getElementById("certifications-grid");
  if (!container) return;

  try {
    const res = await fetch("/api/certifications");
    const data = await res.json();
    certificationsData = data.certifications;
    renderCertifications(certificationsData);
  } catch (err) {
    container.innerHTML = `<div class="p-4 bg-rose-50 text-rose-700 text-xs rounded-xl">Error loading certifications.</div>`;
  }
}

function filterCertifications(category) {
  // Update active pill button style
  const buttons = document.querySelectorAll("#cert-category-filters button");
  buttons.forEach(btn => {
    if (btn.innerText.toLowerCase().includes(category.toLowerCase()) || (category === 'all' && btn.innerText === 'All')) {
      btn.className = "px-3.5 py-1.5 rounded-full text-xs font-bold bg-indigo-600 text-white shadow-2xs";
    } else {
      btn.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors";
    }
  });

  if (category === "all") {
    renderCertifications(certificationsData);
  } else {
    const filtered = certificationsData.filter(c => 
      c.category.toLowerCase().includes(category.toLowerCase()) ||
      c.skills.some(s => s.toLowerCase().includes(category.toLowerCase()))
    );
    renderCertifications(filtered);
  }
}

function renderCertifications(certs) {
  const container = document.getElementById("certifications-grid");
  if (!container) return;

  if (certs.length === 0) {
    container.innerHTML = `<div class="col-span-full p-8 text-center text-slate-500 text-sm">No certifications found for this filter.</div>`;
    return;
  }

  const cardsHtml = certs.map(cert => {
    const skillsHtml = cert.skills.map(s => `
      <span class="inline-block px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[11px] font-medium border border-slate-200">${s}</span>
    `).join("");

    return `
      <div class="glass-card p-5 rounded-2xl border border-slate-200 hover:shadow-md hover:border-indigo-200 transition-all flex flex-col justify-between group msg-animate">
        <div>
          <div class="flex items-start justify-between gap-2 mb-3">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
              ${cert.resume_badge}
            </span>
            <span class="text-[11px] text-slate-500 font-medium">${cert.duration}</span>
          </div>

          <h3 class="text-base font-extrabold text-slate-900 group-hover:text-indigo-600 transition-colors">${cert.title}</h3>
          <p class="text-xs text-indigo-700 font-semibold mt-0.5">Issuer: ${cert.issuer}</p>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">${cert.description}</p>

          <div class="mt-4">
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Skills Tested</p>
            <div class="flex flex-wrap gap-1.5">${skillsHtml}</div>
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-100">
          <a href="${cert.url}" target="_blank" rel="noopener noreferrer" class="w-full py-2.5 px-4 rounded-xl bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-bold text-xs flex items-center justify-center gap-2 transition-all">
            <span>Start Free Certification</span>
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
          </a>
        </div>
      </div>
    `;
  }).join("");

  container.innerHTML = cardsHtml;
  if (window.lucide) lucide.createIcons();
}

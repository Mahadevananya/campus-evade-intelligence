// Student Interest Profiler & Assessment Handler

async function handleProfilerSubmit(event) {
  event.preventDefault();
  
  const year = document.getElementById("p-year").value;
  const branch = document.getElementById("p-branch").value;
  const interest = document.getElementById("p-interest").value;
  const coding_level = document.getElementById("p-level").value;
  const goal = document.getElementById("p-goal").value;

  const submitBtn = document.getElementById("profiler-submit-btn");
  const resultsDiv = document.getElementById("profiler-results");

  // Update sidebar display
  const userDisplay = document.getElementById("user-display-details");
  if (userDisplay) {
    userDisplay.innerText = `B.Tech ${year} • ${branch.split('/')[0]}`;
  }

  submitBtn.disabled = true;
  submitBtn.innerHTML = `
    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
    Analyzing Your Profile with AI...
  `;

  try {
    const res = await fetch("/api/profile/suggest", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ year, branch, interest, coding_level, goal })
    });
    
    const data = await res.json();
    const st = data.structured_data;

    let coursesHtml = st.domain_strategy.free_courses.map(c => `
      <span class="inline-block px-2.5 py-1 bg-white border border-indigo-200 text-indigo-800 text-xs font-semibold rounded-lg shadow-2xs">${c}</span>
    `).join("");

    let actionPlanHtml = st.action_plan_30_days.map(step => `
      <div class="flex items-start gap-3 p-3 bg-white rounded-xl border border-slate-200">
        <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
          ✓
        </div>
        <p class="text-xs text-slate-700 leading-relaxed font-medium">${step}</p>
      </div>
    `).join("");

    const advantageTip = st.offcampus_advantage_tip || "Master DSA and build real projects to stand out off-campus.";

    resultsDiv.classList.remove("hidden");
    resultsDiv.innerHTML = `
      <div class="p-6 rounded-2xl bg-indigo-50/70 border border-indigo-100 space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-white px-2.5 py-1 rounded-full border border-indigo-200">Personalized Blueprint</span>
            <h3 class="text-xl font-extrabold text-slate-900 mt-2">${interest} Track for ${year}</h3>
            <p class="text-xs text-slate-600 mt-1">${st.student_summary}</p>
          </div>
          <button onclick="window.print()" class="px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg flex items-center gap-1.5 shadow-2xs">
            <i data-lucide="printer" class="w-3.5 h-3.5"></i> Save / Print Roadmap
          </button>
        </div>

        <!-- Year Milestone & Warning -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 bg-white rounded-xl border border-indigo-100 shadow-2xs">
            <div class="flex items-center gap-2 text-indigo-700 text-xs font-bold uppercase mb-1">
              <i data-lucide="target" class="w-4 h-4"></i>
              Your Core Milestone for ${year}
            </div>
            <p class="text-xs text-slate-700 leading-relaxed">${st.year_strategy.key_milestone}</p>
          </div>
          <div class="p-4 bg-amber-50/80 rounded-xl border border-amber-200 shadow-2xs">
            <div class="flex items-center gap-2 text-amber-800 text-xs font-bold uppercase mb-1">
              <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-600"></i>
              Common Trap to Avoid
            </div>
            <p class="text-xs text-amber-900 leading-relaxed">${st.year_strategy.warning}</p>
          </div>
        </div>

        <!-- 30-Day Action Plan -->
        <div>
          <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5 flex items-center gap-2">
            <i data-lucide="calendar" class="w-4 h-4 text-indigo-600"></i>
            Your First 30-Day Action Plan
          </h4>
          <div class="space-y-2">
            ${actionPlanHtml}
          </div>
        </div>

        <!-- Stack & Curated Free Courses -->
        <div class="p-4 bg-white rounded-xl border border-slate-200 space-y-3">
          <div>
            <h5 class="text-xs font-bold text-slate-700 uppercase">Recommended Tech Stack</h5>
            <p class="text-xs font-mono text-indigo-600 font-semibold mt-0.5">${st.domain_strategy.stack}</p>
          </div>
          <div>
            <h5 class="text-xs font-bold text-slate-700 uppercase mb-1.5">100% Free Verified Learning Resources</h5>
            <div class="flex flex-wrap gap-2">${coursesHtml}</div>
          </div>
        </div>

        <!-- Off-Campus Advantage Secret -->
        <div class="p-4 bg-gradient-to-r from-emerald-50 to-teal-50 rounded-xl border border-emerald-200">
          <div class="flex items-center gap-2 text-emerald-800 text-xs font-bold uppercase mb-1">
            <i data-lucide="sparkles" class="w-4 h-4 text-emerald-600"></i>
            Off-Campus Superpower Secret
          </div>
          <p class="text-xs text-emerald-900 leading-relaxed font-medium">${advantageTip}</p>
        </div>
      </div>
    `;

    // Scroll to results
    resultsDiv.scrollIntoView({ behavior: 'smooth' });

    if (window.lucide) {
      lucide.createIcons();
    }
  } catch (err) {
    alert("Could not generate roadmap. Please verify the server is running.");
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = `
      <i data-lucide="sparkles" class="w-4 h-4"></i>
      Generate My Personalized Engineering Action Plan
    `;
    if (window.lucide) lucide.createIcons();
  }
}

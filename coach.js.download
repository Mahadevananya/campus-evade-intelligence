// AI Productivity Coach Chat Handler

async function handleCoachSubmit(event) {
  event.preventDefault();
  const input = document.getElementById("coach-input");
  const msg = input.value.trim();
  if (!msg) return;

  appendCoachMessage("user", msg);
  input.value = "";
  await fetchCoachReply(msg);
}

function sendCoachPrompt(text) {
  appendCoachMessage("user", text);
  fetchCoachReply(text);
}

function appendCoachMessage(sender, text) {
  const container = document.getElementById("coach-messages");
  const isUser = sender === "user";

  const msgDiv = document.createElement("div");
  msgDiv.className = `flex gap-3 max-w-2xl msg-animate ${isUser ? "ml-auto flex-row-reverse" : ""}`;

  const iconHtml = isUser 
    ? `<div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center shrink-0 text-xs font-bold">You</div>`
    : `<div class="w-8 h-8 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0"><i data-lucide="zap" class="w-4 h-4"></i></div>`;

  const parsedContent = isUser ? `<p>${text}</p>` : (window.marked ? marked.parse(text) : `<p>${text}</p>`);

  msgDiv.innerHTML = `
    ${iconHtml}
    <div class="${isUser ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-800 ai-prose"} p-4 rounded-2xl ${isUser ? "rounded-tr-sm" : "rounded-tl-sm"} text-sm shadow-2xs">
      ${parsedContent}
    </div>
  `;

  container.appendChild(msgDiv);
  container.scrollTop = container.scrollHeight;
  if (window.lucide) lucide.createIcons();
}

async function fetchCoachReply(query) {
  const container = document.getElementById("coach-messages");
  
  // Show thinking indicator
  const loadingDiv = document.createElement("div");
  loadingDiv.id = "coach-loading";
  loadingDiv.className = "flex gap-3 max-w-2xl msg-animate";
  loadingDiv.innerHTML = `
    <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
      <i data-lucide="zap" class="w-4 h-4"></i>
    </div>
    <div class="bg-slate-100 p-4 rounded-2xl rounded-tl-sm text-xs text-slate-500 flex items-center gap-2">
      <div class="w-3 h-3 border-2 border-amber-600 border-t-transparent rounded-full animate-spin"></div>
      Analyzing engineering schedule & formulating high-ROI strategy...
    </div>
  `;
  container.appendChild(loadingDiv);
  container.scrollTop = container.scrollHeight;
  if (window.lucide) lucide.createIcons();

  try {
    const res = await fetch("/api/productivity/chat", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ message: query })
    });
    const data = await res.json();
    
    // Remove loading
    const loader = document.getElementById("coach-loading");
    if (loader) loader.remove();

    appendCoachMessage("bot", data.reply);
  } catch (err) {
    const loader = document.getElementById("coach-loading");
    if (loader) loader.remove();
    appendCoachMessage("bot", "⚠️ Could not connect to the coach. Please check if the server is active.");
  }
}
